# Port de l'API backend
APP_PORT=3001

# Secret JWT pour les tokens d'authentification
JWT_SECRET=change-me-avec-une-longue-cle-secrete

# Chaîne de connexion ODBC vers la base HFSQL
# Exemple: Driver={PCSoft HFSQL};Host=192.168.1.100;UID=admin;PWD=password;DATABASE=MaBase
ODBC_CONNECTION_STRING=

# Utilisateur admin par défaut (créé au premier démarrage)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123
DEFAULT_ADMIN_EMAIL=

# Fuseau horaire
TZ=Europe/Paris
